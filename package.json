{
  "name": "turtune",
  "version": "1.2.1",
  "description": "Turtune — cliente de escritorio estilo Spotify que reproduce SOLO audio de YouTube (audio-only streaming). Tauri/Electron + React + yt-dlp.",
  "author": "Xenakis165",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "test": "node --test test/",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production electron .",
    "selftest": "node electron/core/selftest.js",
    "dist": "vite build && electron-builder --win nsis",
    "pack": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "app.turtune.desktop",
    "productName": "Turtune",
    "copyright": "Copyright © Xenakis165",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "tools/yt-dlp.exe",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "tools/yt-dlp.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Turtune",
      "artifactName": "Turtune-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xenakis930-ui",
        "repo": "Turtune-v1.2.0",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
